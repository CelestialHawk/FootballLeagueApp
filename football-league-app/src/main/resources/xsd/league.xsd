<?xml version="1.0" encoding="UTF-8"?>

<xs:schema
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    targetNamespace="http://footballapp.com/league"
    xmlns:tns="http://footballapp.com/league"
    elementFormDefault="qualified">

    <xs:element name="getTeamsRequest">
        <xs:complexType>
            <xs:sequence>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="getTeamsResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="team" type="tns:team" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="addMatchRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="homeTeamId" type="xs:long"/>
                <xs:element name="awayTeamId" type="xs:long"/>
                <xs:element name="homeScore" type="xs:int"/>
                <xs:element name="awayScore" type="xs:int"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="addMatchResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="matchId" type="xs:long"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="getLeagueTableRequest">
    <xs:complexType>
        <xs:sequence/>
    </xs:complexType>
</xs:element>

<xs:element name="getLeagueTableResponse">
    <xs:complexType>
        <xs:sequence>
            <xs:element name="team" maxOccurs="unbounded">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="id" type="xs:long"/>
                        <xs:element name="name" type="xs:string"/>
                        <xs:element name="played" type="xs:int"/>
                        <xs:element name="wins" type="xs:int"/>
                        <xs:element name="draws" type="xs:int"/>
                        <xs:element name="losses" type="xs:int"/>
                        <xs:element name="points" type="xs:int"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
</xs:element>

    <xs:complexType name="team">
        <xs:sequence>
            <xs:element name="id" type="xs:long"/>
            <xs:element name="name" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

</xs:schema>